# Canonical MongoDB configuration
# Prefer MONGO_HOST/MONGO_USERNAME/MONGO_PASSWORD when your password contains
# special characters; the application URL-encodes those credentials safely.
MONGO_HOST=cluster0.xxxxx.mongodb.net
MONGO_USERNAME=campusvoice
MONGO_PASSWORD=REPLACE_ME
MONGO_DB_NAME=campusvoice

# Alternatively, provide a complete URI. If used, URL-encode special characters
# in the username/password portion of the URI.
# MONGO_URI=mongodb+srv://campusvoice:REPLACE_ME@cluster0.xxxxx.mongodb.net/campusvoice?retryWrites=true&w=majority

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
